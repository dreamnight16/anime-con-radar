---
import '../styles/site.css';
import { snapshot, snapshotTimes } from '../lib/events';

interface Props {
  title: string;
  description?: string;
  /** 顶栏高亮项；分类/城市详情页归属「全部活动」。 */
  active?: 'home' | 'events' | 'cities' | 'data';
}

const {
  title,
  description = 'ComiRadar 漫展雷达 — 自动汇总全国漫展、同人展与 ACG 演出的时间、城市与购票信息。',
  active = 'home',
} = Astro.props;

const nav = [
  { key: 'home', href: '/', label: '总览' },
  { key: 'events', href: '/events/', label: '全部活动' },
  { key: 'cities', href: '/cities/', label: '城市' },
  { key: 'data', href: '/data/', label: '数据说明' },
] as const;

const stamp = snapshotTimes(snapshot.pendingScrapedAt);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="stylesheet" href="/vendor/dndl/tokens.css" />
    <link rel="stylesheet" href="/vendor/dndl/materials.css" />
    <link rel="stylesheet" href="/vendor/dndl/motion.css" />
  </head>
  <body>
    <a class="skip" href="#main">跳至主要内容</a>

    <header class="site-header dn-acrylic">
      <div class="wrap">
        <a class="wordmark" href="/">
          ComiRadar<small>漫展雷达</small>
        </a>
        <nav class="site-nav" aria-label="主导航">
          {nav.map((item) => (
            <a href={item.href} aria-current={active === item.key ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <section>
          <h2>关于 ComiRadar</h2>
          <p>
            数据由 <a href="https://github.com/dreamnight16/anime-con-radar" target="_blank" rel="noopener noreferrer">anime-con-radar</a>
            抓取管线每日 UTC 02:00 运行后生成，站点为构建时快照，页面不发起实时请求。
          </p>
        </section>
        <section>
          <h2>当前快照</h2>
          <p>
            {stamp ? <>抓取于 {stamp.cst}（{stamp.utc}）</> : '数据中未提供抓取时间'}
          </p>
          <p>共 {snapshot.total} 条记录：进行中 {snapshot.ongoing} · 即将开始 {snapshot.upcoming} · 已结束 {snapshot.past}</p>
        </section>
        <section>
          <h2>链接</h2>
          <ul>
            <li><a href="/data/">数据来源与可信度说明</a></li>
            <li><a href="https://github.com/dreamnight16/anime-con-radar" target="_blank" rel="noopener noreferrer">GitHub 仓库</a></li>
            <li><a href="https://dreamnight.net.cn" target="_blank" rel="noopener noreferrer">DreamNight</a></li>
          </ul>
        </section>
      </div>
      <div class="foot-bottom">
        <div class="wrap">
          <p>活动信息以主办方与票务平台公布为准，请购票前自行核实。</p>
          <p>DreamNight 品牌设计语言 DNDL v1.0 · 实现 1.1.0</p>
        </div>
      </div>
    </footer>

    <script>
      // 入场动画只在页面加载时播放一次。移除类名后，任何后续显隐
      // （筛选切换、展开「已结束」归档）都不会重播入场。
      const rising = Array.from(document.querySelectorAll<HTMLElement>('.dn-rise'));
      for (const el of rising) {
        el.addEventListener('animationend', () => el.classList.remove('dn-rise'), { once: true });
      }
      // 兜底：初始处于折叠 <details> 内（display:none）的元素不会产生动画事件。
      window.setTimeout(() => {
        for (const el of rising) el.classList.remove('dn-rise');
      }, 1200);

      // 渐进增强：Escape 关闭已展开的活动详情，并把焦点交回触发它的摘要。
      // 未启用 JS 时 <details> 仍可通过键盘正常打开与关闭。
      document.addEventListener('keydown', (event: KeyboardEvent) => {
        if (event.key !== 'Escape') return;
        const open = Array.from(document.querySelectorAll<HTMLDetailsElement>('details.ev-details[open]'));
        if (open.length === 0) return;
        const activeEl = document.activeElement;
        const target = open.find((d) => activeEl && d.contains(activeEl)) ?? open[open.length - 1];
        const fromInside = Boolean(activeEl && target.contains(activeEl));
        target.open = false;
        if (fromInside) target.querySelector('summary')?.focus();
      });
    </script>
  </body>
</html>
